# Copy to .env and adjust. All values are optional.

# Host port the app is published on.
HTTP_PORT=8080

# Tesseract language packs baked into the image (Debian suffixes). Rebuild after changing.
# Full list: https://packages.debian.org/search?keywords=tesseract-ocr-
OCR_LANGS=eng tur deu fra spa ita por nld
DEFAULT_LANGUAGE=eng

# Limits
MAX_FILE_MB=100
MAX_FILES_PER_JOB=20
MAX_PAGES_PER_JOB=1000
NGINX_MAX_BODY=1g

# Throughput: jobs processed in parallel, and CPU workers per job (default: all cores).
MAX_CONCURRENT_JOBS=2
OCR_JOBS=
# 0 = fastest, 1 = lossless size optimisation (default), 2/3 = smaller files, slower.
OCR_OPTIMIZE=1

# Results are deleted this many minutes after a job finishes.
JOB_TTL_MINUTES=120
